# Obtén una clave en https://brave.com/search/api/ y colócala aquí.
# SearXNG sigue funcionando aunque no configures Brave.
BRAVE_SEARCH_API_KEY=

# Se genera automáticamente en el primer arranque.
SEARXNG_SECRET=GENERATED_ON_FIRST_RUN
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_ENABLED=true
SEARXNG_LANGUAGE=all
SEARXNG_CATEGORIES=general,science
SEARXNG_REQUEST_GAP_SECONDS=1.0

# Cobertura adaptativa: aproximadamente una consulta cada 450 palabras.
WEB_SEARCH_MAX_QUERIES=120
WEB_SEARCH_MAX_RESULTS=160
WEB_SEARCH_MAX_DOWNLOADS=50
WEB_SEARCH_MAX_PER_DOMAIN=3
BRAVE_SEARCH_LANG=es

# Descubrimiento académico gratuito y sin API keys.
ACADEMIC_ENABLED=true
ACADEMIC_MAX_QUERIES=8
ACADEMIC_MAX_RESULTS_PER_QUERY=5
ACADEMIC_MAX_DOWNLOADS=35
# Opcional: endpoints OAI-PMH públicos separados por punto y coma.
ACADEMIC_OAI_ENDPOINTS=
ACADEMIC_OAI_MAX_RECORDS=250
# Opcional: correo de contacto para el polite pool de Crossref.
CROSSREF_MAILTO=

# Similitud semántica local (la dependencia pesada se instala aparte).
SEMANTIC_ENABLED=true
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_THRESHOLD=0.78
SEMANTIC_DEVICE=cpu
SEMANTIC_MAX_THESIS_CHUNKS=800
SEMANTIC_MAX_CHUNKS_PER_SOURCE=80
SEMANTIC_MAX_TOTAL_SOURCE_CHUNKS=2000
